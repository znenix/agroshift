# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files: never commit secrets (CLAUDE.md §1.8); an example file may be committed
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# data pipeline: raw prefetch output (SPEC §4); built files in public/data/ ARE committed
/data/raw/

# handed-over spec bundle; its files are committed as CLAUDE.md and docs/SPEC.md
/agroshift-spec.zip

# copied from node_modules/maplibre-gl before dev/build (scripts/copy-maplibre-worker.mjs)
public/maplibre/
